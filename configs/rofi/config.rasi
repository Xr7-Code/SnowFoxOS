configuration {
    modi:           "drun,run,window";
    show-icons:     true;
    icon-theme:     "Papirus-Dark";
    drun-display-format: "{name}";
    display-drun:   "󰍉";
    display-run:    "󰞷";
    display-window: "󰕰";
}

* {
    font:             "JetBrainsMono Nerd Font 10.5";

    /* Palette — rendered from ~/.config/snowfox/palette.conf.
       Switch themes with:  snowfox theme <name>          */
    bg:               #1a1825;
    bg-alt:           #201e2e;
    bg-hover:         #332f50;
    fg:               #e0d9f5;
    fg-alt:           #6e6a8a;
    on-accent:        #ffffff;

    accent:           #9d6fe8;
    accent-lt:        #b899ff;

    window-bg:        rgba(26, 24, 37, 0.85);
    panel-bg:         rgba(32, 30, 46, 0.80);
    hover-bg:         rgba(129, 57, 232, 0.18);
    sel-bg:           rgba(129, 57, 232, 0.25);
    panel-border:     rgba(129, 57, 232, 0.30);
    border-glow:      rgba(184, 153, 255, 0.50);

    background-color: transparent;
    text-color:       @fg;
}

window {
    background-color: @window-bg;
    border:           1.5px solid;
    border-color:     @border-glow;
    border-radius:    14px;
    width:            520px;
    padding:          14px;
    x-offset:         0;
    y-offset:         -60px;
    location:         center;
}

mainbox {
    background-color: transparent;
    spacing:          10px;
    children:         [inputbar, listview];
}

/* ── Search bar ─────────────────────────────────────────── */
inputbar {
    background-color: @panel-bg;
    border-radius:    10px;
    border:           1px solid;
    border-color:     @panel-border;
    padding:          10px 14px;
    spacing:          10px;
    children:         [prompt, entry];
}

prompt {
    background-color: transparent;
    text-color:       @accent-lt;
    font:             "JetBrainsMono Nerd Font Bold 12";
}

entry {
    background-color: transparent;
    text-color:       @fg;
    placeholder:      "Search applications...";
    placeholder-color: @fg-alt;
    cursor:           text;
}

/* ── Result list ────────────────────────────────────────── */
listview {
    background-color: transparent;
    lines:            7;
    columns:          1;
    spacing:          4px;
    fixed-height:     true;
    scrollbar:        false;
}

element {
    background-color: @panel-bg;
    border-radius:    8px;
    padding:          8px 12px;
    spacing:          12px;
    orientation:      horizontal;
    children:         [element-icon, element-text];
}

element normal normal {
    background-color: transparent;
    text-color:       @fg;
}

element normal active {
    background-color: @hover-bg;
    text-color:       @accent-lt;
}

element selected normal {
    background-color: @sel-bg;
    border:           1px solid;
    border-color:     @border-glow;
    text-color:       @on-accent;
}

element selected active {
    background-color: @sel-bg;
    text-color:       @on-accent;
}

element alternate normal {
    background-color: transparent;
}

element-icon {
    size:             22px;
    vertical-align:   0.5;
    horizontal-align: 0.5;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
}

scrollbar {
    background-color: @bg-alt;
    handle-color:     @fg-alt;
    border-radius:    4px;
    width:            4px;
}
