#!/bin/bash

LOCKFILE="/tmp/power-menu.lock"

if [ -e "$LOCKFILE" ]; then
    pkill wofi
    rm -f "$LOCKFILE"
    exit 0
fi

touch "$LOCKFILE"

choice=$(printf "⏻  Herunterfahren\n↺  Neu starten\n⎋  Abmelden\n🔒  Sperren\n✕  Abbrechen" | \
    wofi --show dmenu \
         --prompt "Power Menu" \
         --width 300 \
         --height 230 \
         --insensitive)

rm -f "$LOCKFILE"

case "$choice" in
    "⏻  Herunterfahren")
        sudo /sbin/poweroff
        ;;
    "↺  Neu starten")
        sudo /sbin/reboot
        ;;
    "⎋  Abmelden")
        swaymsg exit
        ;;
    "🔒  Sperren")
        swaylock &
        ;;
    *)
        exit 0
        ;;
esac
