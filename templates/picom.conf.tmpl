# ============================================================
#    SnowFoxOS v3.4 — Picom Compositor
#    Template: templates/picom.conf.tmpl
#    Rendered to: ~/.config/picom.conf
#    Theme: ${THEME_NAME}
#    Note: Picom has no color tokens — template exists for
#          consistency; opacity values could be themed later.
# ============================================================

backend     = "glx"
vsync       = true
glx-no-stencil = true

# ── Shadows ─────────────────────────────────────────────────
shadow           = true
shadow-radius    = 12
shadow-offset-x  = -6
shadow-offset-y  = -6
shadow-opacity   = 0.4
shadow-exclude   = [
    "name = 'Notification'",
    "class_g = 'Polybar'",
    "class_g = 'Rofi'",
    "_GTK_FRAME_EXTENTS@:c"
]

# ── Fading ──────────────────────────────────────────────────
fading          = true
fade-in-step    = 0.06
fade-out-step   = 0.06
fade-delta      = 5
no-fading-openclose = false

# ── Opacity ─────────────────────────────────────────────────
active-opacity   = 1.0
inactive-opacity = 0.92
frame-opacity    = 1.0
inactive-opacity-override = false

opacity-rule = [
    "100:class_g = 'Polybar'",
    "100:class_g = 'Rofi'",
    "100:class_g = 'i3lock'",
    "100:_NET_WM_STATE@:32a *= '_NET_WM_STATE_FULLSCREEN'"
]

# ── Blur ────────────────────────────────────────────────────
blur-background        = false
blur-background-frame  = false

# ── Rounded Corners ─────────────────────────────────────────
corner-radius = 6
rounded-corners-exclude = [
    "class_g = 'Polybar'",
    "class_g = 'i3lock'"
]

# ── GLX tuning ──────────────────────────────────────────────
glx-swap-method     = "undefined"
use-damage          = true
log-level           = "warn"
